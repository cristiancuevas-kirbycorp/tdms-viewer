<Window x:Class="TdmsViewer.CursorCalcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cursor Calculations" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16" MinWidth="280">
        <TextBlock Text="Show these values between cursors A and B:" Margin="0,0,0,10" />
        <StackPanel x:Name="CalcList" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="14,5" Margin="0,0,8,0" />
            <Button Content="OK" IsDefault="True" Padding="14,5" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
