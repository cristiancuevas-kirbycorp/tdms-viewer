<Window x:Class="TdmsViewer.CrashReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TDMS Viewer — Problem Report"
        Width="720" Height="580" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Something went wrong." FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,12"
                   Text="The app will keep running. Please copy this report and send it to the developer (e.g. in a Teams message) so the problem can be fixed." />

        <TextBlock Grid.Row="2" Text="What were you doing right before this happened? (optional)" Margin="0,0,0,4" />
        <TextBox x:Name="DescriptionBox" Grid.Row="3" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"
                 TextChanged="DescriptionBox_TextChanged" />

        <TextBox x:Name="ReportBox" Grid.Row="4" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="#F7F7F7" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Open log folder" Click="OpenLog_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button x:Name="CopyButton" Content="Copy report" Click="Copy_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Close" Click="Close_Click" Padding="12,6" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
